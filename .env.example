# =============================================================================
# Dagster + Ray Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.
#
# Dagster uses EnvVar() for runtime resolution (values hidden from UI).
# See: https://docs.dagster.io/guides/dagster/using-environment-variables-and-secrets

# --- Deployment Environment ---
# One of: local, dev, test, acc, prod
DAGSTER_DEPLOYMENT=local

# --- Postgres (Dagster storage backend) ---
DAGSTER_PG_USERNAME=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_HOST=localhost
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster

# --- Ray Cluster ---
# For local dev, leave RAY_ADDRESS empty to use LocalRay (auto-init).
# For remote clusters, set to ray://<head-node>:10001
RAY_ADDRESS=
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0

# --- Object Storage (S3 / MinIO) ---
# MinIO is used locally to emulate S3.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=platform-data

# --- ML Tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
